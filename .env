# Pixora backend environment (development defaults)
NODE_ENV=development
PORT=4000

# Database (better-sqlite3 for dev)
DB_TYPE=better-sqlite3
DB_PATH=./data/pixora.db
DB_LOG=false

# JWT secrets
JWT_ACCESS_SECRET=pixora-access-secret-change-me
JWT_REFRESH_SECRET=pixora-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# CORS
FRONTEND_URL=http://localhost:3000

# Realtime / Push
# Generate VAPID keys by running: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BIVyRl4Cnd5P24Mh68OyrkL8eXYa4EtocFHAF60jbTigLhIz6SX0Ie7kI3DIqRLd0PFc-h0GqyoPDgo4FmJJnA0
VAPID_PRIVATE_KEY=CGqKH2i7QQJ79zpA1e0JoIxix5QdfUza_Z6bm0NybEI
VAPID_SUBJECT=mailto:dev@pixora.app
PUSH_ENABLED=true
