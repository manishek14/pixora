# Lenz Backend Environment
NODE_ENV=development
PORT=4000

# Database - use 'sqlite' for local dev (no Docker needed), 'postgres' for prod
DB_TYPE=better-sqlite3
DB_PATH=./data/lenz.db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=lenz
# DB_USER=postgres
# DB_PASS=postgres
DB_LOG=false

# JWT
JWT_ACCESS_SECRET=lenz-access-secret-change-me-in-production
JWT_REFRESH_SECRET=lenz-refresh-secret-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# Frontend URL
FRONTEND_URL=http://localhost:3000
